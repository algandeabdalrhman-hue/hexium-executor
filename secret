name: Build Hexium Executor Dylib

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    
    steps:
    - uses: actions/checkout@v4
    
    - name: Install Lua
      run: brew install lua
    
    - name: Compile Lua Dylib for iOS
      run: |
        clang -arch arm64 -fPIC -shared \
          -miphoneos-version-min=13.0 \
          -isysroot $(xcrun --sdk iphoneos --show-sdk-path) \
          executor.c \
          -I/usr/local/opt/lua/include \
          -L/usr/local/opt/lua/lib \
          -llua -undefined dynamic_lookup \
          -o executor.dylib
    
    - name: Upload Dylib Artifact
      uses: actions/upload-artifact@v4
      with:
        name: executor-dylib
        path: executor.dylib
