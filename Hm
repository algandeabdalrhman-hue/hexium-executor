name: Build Lua iOS Dylib

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download Lua
        shell: bash
        run: |
          set -euo pipefail

          LUA_VERSION="5.4.7"

          curl -fsSL \
            "https://www.lua.org/ftp/lua-${LUA_VERSION}.tar.gz" \
            -o lua.tar.gz

          tar -xzf lua.tar.gz

      - name: Build Lua for iPhoneOS ARM64
        shell: bash
        run: |
          set -euo pipefail

          SDK="$(xcrun --sdk iphoneos --show-sdk-path)"

          cd lua-5.4.7

          make clean || true

          make \
            CC="clang -arch arm64 -isysroot $SDK -miphoneos-version-min=13.0" \
            MYCFLAGS="-fPIC" \
            MYLDFLAGS="-arch arm64 -isysroot $SDK -miphoneos-version-min=13.0" \
            generic

          mkdir -p "$GITHUB_WORKSPACE/lua/include"
          mkdir -p "$GITHUB_WORKSPACE/lua/lib"

          cp src/*.h "$GITHUB_WORKSPACE/lua/include/"
          cp src/liblua.a "$GITHUB_WORKSPACE/lua/lib/"

      - name: Verify Lua headers
        shell: bash
        run: |
          set -euo pipefail

          test -f "$GITHUB_WORKSPACE/lua/include/lua.h"

          echo "Lua headers:"
          ls -la "$GITHUB_WORKSPACE/lua/include"

          echo "Lua library:"
          ls -lh "$GITHUB_WORKSPACE/lua/lib/liblua.a"

      - name: Build iOS dylib
        shell: bash
        run: |
          set -euo pipefail

          SDK="$(xcrun --sdk iphoneos --show-sdk-path)"

          clang \
            -arch arm64 \
            -fPIC \
            -dynamiclib \
            -isysroot "$SDK" \
            -miphoneos-version-min=13.0 \
            -I"$GITHUB_WORKSPACE/lua/include" \
            -L"$GITHUB_WORKSPACE/lua/lib" \
            -o libLuaBridge.dylib \
            lua_bridge.c \
            -llua

      - name: Verify dylib
        shell: bash
        run: |
          set -euo pipefail

          file libLuaBridge.dylib
          xcrun lipo -info libLuaBridge.dylib

      - name: Upload dylib
        uses: actions/upload-artifact@v4
        with:
          name: ios-arm64-lua-dylib
          path: libLuaBridge.dylib
