name: Build Lua iOS Dylib

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Build Lua for iPhoneOS
        shell: bash
        run: |
          set -euo pipefail

          LUA_VERSION="5.4.7"
          curl -L \
            "https://www.lua.org/ftp/lua-${LUA_VERSION}.tar.gz" \
            -o lua.tar.gz

          tar -xzf lua.tar.gz
          cd "lua-${LUA_VERSION}"

          SDK="$(xcrun --sdk iphoneos --show-sdk-path)"

          make clean || true

          make \
            CC="clang -arch arm64 -isysroot ${SDK} -miphoneos-version-min=13.0" \
            MYCFLAGS="-fPIC" \
            MYLDFLAGS="-arch arm64 -isysroot ${SDK} -miphoneos-version-min=13.0" \
            generic

          mkdir -p "$GITHUB_WORKSPACE/lua-ios/include"
          mkdir -p "$GITHUB_WORKSPACE/lua-ios/lib"

          cp src/*.h "$GITHUB_WORKSPACE/lua-ios/include/"
          cp src/liblua.a "$GITHUB_WORKSPACE/lua-ios/lib/"

      - name: Build dylib
        shell: bash
        run: |
          set -euo pipefail

          SDK="$(xcrun --sdk iphoneos --show-sdk-path)"

          clang \
            -arch arm64 \
            -fPIC \
            -dynamiclib \
            -isysroot "$SDK" \
            -miphoneos-version-min=13.0 \
            -I"$GITHUB_WORKSPACE/lua-ios/include" \
            executor.c \
            "$GITHUB_WORKSPACE/lua-ios/lib/liblua.a" \
            -o executor.dylib

      - name: Verify dylib
        run: |
          file executor.dylib
          xcrun lipo -info executor.dylib

      - name: Upload dylib
        uses: actions/upload-artifact@v4
        with:
          name: ios-arm64-dylib
          path: executor.dylib
